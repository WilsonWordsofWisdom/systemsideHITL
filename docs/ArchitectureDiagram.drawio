t="100" as="geometry"/></mxCell><mxCell id="c3a-wa" value="&lt;b&gt;WebAuthn service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Challenge bound to ticket + hash + nonce; UV required&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="530" width="210" height="100" as="geometry"/></mxCell><mxCell id="c3a-cl" value="&lt;b&gt;Actor classifier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Tiers, precedence, 60 s signal window, escalate-only&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="210" height="100" as="geometry"/></mxCell><mxCell id="c3a-po" value="&lt;b&gt;Policy engine&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;hitl-policy.yaml; unlisted mutating action denied&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="c3a-tk" value="&lt;b&gt;Ticket service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;State machine, atomic consume, wrong_session check&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeCo