<diagram name="Dynamic: Gated action" id="hitl-dyn"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dyn-title" value="&lt;b&gt;Dynamic: a gated action from request to execution&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;submit_application as an example. Numbers show the order of calls.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="dyn-clpo" value="&lt;b&gt;Classifier and policy&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Components]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Actor class, then allow / gate / deny&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="240" height="130" as="geometry"/></mxCell><mxCell id="dyn-agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Web or MCP&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="170" as="geometry"/></mxCell><mxCell id="dyn-adapter" value="&lt;b&gt;Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Journey API route or MCP tool]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Calls hitlGuard before anything else&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="260" height="170" as="geometry"/></mxCell><mxCell id="dyn-guard" value="&lt;b&gt;hitlGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Single choke point&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="240" height="170" as="geometry"/></mxCell><mxCell id="dyn-human" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Approver&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="240" height="170" as="geometry"/></mxCell><mxCell id="dyn-appr" value="&lt;b&gt;Approval page&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component: /approve or /device]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Preview comes from the ticket row; passkey prompt, user verification required&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="260" height="170" as="geometry"/></mxCell><mxCell id="dyn-tk" value="&lt;b&gt;Ticket service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Bound to user, action, hash and requesting session&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="620" width="240" height="170" as="geometry"/></mxCell><mxCell id="dyn-db" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Database]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;hitl_tickets&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1480" y="630" width="200" height="150" as="geometry"/></mxCell><mxCell id="dyn-s1" value="1. submit_application (no ticket)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-agent" target="dyn-adapter"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s6" value="6. requires_human_approval,&lt;br&gt;ticket_id, continue_url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-adapter" target="dyn-agent"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s11" value="11. retry with ticket id&lt;br&gt;and same payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-agent" target="dyn-adapter"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s13" value="13. executed, exactly once" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-adapter" target="dyn-agent"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s2" value="2. hitlGuard(action,&lt;br&gt;resource, payload)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-adapter" target="dyn-guard"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s3" value="3. classify actor,&lt;br&gt;decide() = gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-guard" target="dyn-clpo"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s4" value="4. create ticket&lt;br&gt;(body + resource hash)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-guard" target="dyn-tk"><mxGeometry x="0" y="-110" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s12" value="12. atomic consume if approved, same user&lt;br&gt;and session, hash matches, not expired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-guard" target="dyn-tk"><mxGeometry x="0" y="200" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s5" value="5. insert pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-tk" target="dyn-db"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s10" value="10. pending to approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-tk" target="dyn-db"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s7" value="7. relays continue_url&lt;br&gt;(behaviour under test)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-agent" target="dyn-human"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s8" value="8. opens link,&lt;br&gt;passkey prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-human" target="dyn-appr"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-s9" value="9. verify assertion (challenge =&lt;br&gt;H(ticket, hash, nonce)), approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dyn-appr" target="dyn-tk"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dyn-note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Steps 1 to 6 happen once; 11 to 13 happen after approval.&lt;br&gt;• If the agent retries from another session, step 12 rejects with reason wrong_session.&lt;br&gt;• If the draft is edited after approval, the resource hash differs and step 12 rejects.&lt;br&gt;• A cookie alone never authorises a high-risk action; the ticket does." style="text;html=1;strokeColor=#BBBBBB;fillColor=#FFFFFF;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="Deployment" id="hitl-dep"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dep-title" value="&lt;b&gt;Deployment: production&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;Free Vercel and Supabase tiers for build phases 0-5; paid tiers for phase 6 live agent testing.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="dep-nlap" value="&lt;b&gt;User laptop&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[macOS]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="340" height="300" as="geometry"/></mxCell><mxCell id="dep-brow" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Chrome or agentic browser]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Runs signals.js and the WebAuthn client&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="90" as="geometry"/></mxCell><mxCell id="dep-plat" value="&lt;b&gt;Platform authenticator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Touch ID / synced passkey]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Approver passkey, enrolled beforehand&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="280" height="90" as="geometry"/></mxCell><mxCell id="dep-nph" value="&lt;b&gt;User phone&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[iOS or Android]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="340" height="220" as="geometry"/></mxCell><mxCell id="dep-phone" value="&lt;b&gt;Passkey authenticator and browser&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[/device page]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Used for T9 and a sample of runs&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="280" height="130" as="geometry"/></mxCell><mxCell id="dep-nagent" value="&lt;b&gt;Agent vendor cloud&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[not under our control]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="340" height="220" as="geometry"/></mxCell><mxCell id="dep-cagent" value="&lt;b&gt;Cloud browser or MCP client&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[ChatGPT agent, Claude, Manus, Muse, others]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Signs requests with Web Bot Auth if supported&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="280" height="130" as="geometry"/></mxCell><mxCell id="dep-nver" value="&lt;b&gt;Vercel&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[production hostname *.vercel.app = WebAuthn RP ID]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="520" height="560" as="geometry"/></mxCell><mxCell id="dep-fweb" value="&lt;b&gt;Web UI and API server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Node.js serverless function]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Next.js App Router&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="460" height="90" as="geometry"/></mxCell><mxCell id="dep-fmcp" value="&lt;b&gt;MCP and OAuth server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Node.js serverless function]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/mcp, /oauth/*, /.well-known/*&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="270" width="460" height="90" as="geometry"/></mxCell><mxCell id="dep-fcore" value="&lt;b&gt;Enforcement core&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Library bundled into both functions]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Policy and classifier config read at boot&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="530" y="390" width="460" height="90" as="geometry"/></mxCell><mxCell id="dep-fenv" value="&lt;b&gt;Configuration&lt;/b&gt;&lt;br&gt;Secrets in Vercel environment variables only. Preview deployments do not support passkeys (different hostname)." style="text;html=1;strokeColor=#BBBBBB;fillColor=#FFFFFF;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="520" width="460" height="80" as="geometry"/></mxCell><mxCell id="dep-nsup" value="&lt;b&gt;Supabase project&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[free tier then paid]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1160" y="150" width="310" height="330" as="geometry"/></mxCell><mxCell id="dep-pool" value="&lt;b&gt;Connection pooler&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Transaction mode, port 6543]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Used by the app; prepared statements off&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1190" y="210" width="250" height="90" as="geometry"/></mxCell><mxCell id="dep-pg" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Direct connection, port 5432]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;RLS on every table, no anon policies. Direct string used for migrations and seed.&lt;/span&gt;" styl