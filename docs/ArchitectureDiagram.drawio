<diagram name="C3 Components: MCP + OAuth" id="hitl-c3b"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3b-title" value="&lt;b&gt;C3: Components. MCP and OAuth server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;Every tool call goes through the same hitlGuard as the web routes. The class on /mcp is always at least declared_agent.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="c3b-mcpa" value="&lt;b&gt;MCP agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Route 1 clients&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="220" height="110" as="geometry"/></mxCell><mxCell id="c3b-bmcp" value="&lt;b&gt;MCP side&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[Container: MCP and OAuth server]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="1060" height="470" as="geometry"/></mxCell><mxCell id="c3b-boauth" value="&lt;b&gt;OAuth 2.1 authorization server&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[Container: MCP and OAuth server]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="270" y="580" width="1060" height="270" as="geometry"/></mxCell><mxCell id="c3b-m1" value="&lt;b&gt;MCP transport&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Streamable HTTP; negotiates 2026-07-28 or 2025-11-25&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-m9" value="&lt;b&gt;Token validator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Bearer to user + client_id + act claim; verifies signature with the key store&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-m5" value="&lt;b&gt;Capability logger&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;On initialize (2025-11-25) or per request (2026-07-28)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-m2" value="&lt;b&gt;Tool registry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Tools 1-9, get_approval_status, get_journey_state; neutral descriptions&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-m3" value="&lt;b&gt;Step-scoped lister&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;tools/list from DB state (flag MCP_STEP_SCOPED_TOOLS)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-m4" value="&lt;b&gt;Gate-mode handler&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;elicitation (URL mode) or tool_result (MCP_GATE_MODE)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-g" value="&lt;b&gt;hitlGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Core component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Enforcement core (see C3 Web API + core)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#CFE3F7;strokeColor=#5D82A8;fontColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="1030" y="280" width="240" height="90" as="geometry"/></mxCell><mxCell id="c3b-tk" value="&lt;b&gt;Ticket service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Core component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Creates tickets, returns continue_url&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#CFE3F7;strokeColor=#5D82A8;fontColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="1030" y="400" width="240" height="90" as="geometry"/></mxCell><mxCell id="c3b-sv" value="&lt;b&gt;Journey services&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Core component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Executed only if the guard allows&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#CFE3F7;strokeColor=#5D82A8;fontColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="250" height="90" as="geometry"/></mxCell><mxCell id="c3b-o1" value="&lt;b&gt;Client registration&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Dynamic registration; exact-match redirect URIs&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-o2" value="&lt;b&gt;Authorize and consent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;PKCE; shows client name; user must be signed in&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-o3" value="&lt;b&gt;Token endpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Short-lived tokens; sub = user, act = client; audience /mcp&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="250" height="100" as="geometry"/></mxCell><mxCell id="c3b-human" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Approves the client on the consent screen&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="880" width="250" height="90" as="geometry"/></mxCell><mxCell id="c3b-db" value="&lt;b&gt;Postgres database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;OAuth clients, codes, tokens, signing keys&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1050" y="920" width="240" height="100" as="geometry"/></mxCell><mxCell id="c3b-e1" value="Tool calls&lt;br&gt;[MCP, bearer]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;