<mxfile host="app.diagrams.net">
<diagram name="C1 System Context" id="hitl-c1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1-title" value="&lt;b&gt;C1: System Context. DemoGov Permits (HITL prototype)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;Who and what interacts with the system. Fictional service, demo data only.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="c1-human" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Account holder and approver. Asks an agent to act for them; approves gated steps with a passkey.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="280" height="130" as="geometry"/></mxCell><mxCell id="c1-badm" value="&lt;b&gt;Browser agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External software systems]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Route 2. Operate the site in a browser: Claude in Chrome, Copilot in Edge, ChatGPT agent, Comet, Manus, Muse, others.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="300" height="150" as="geometry"/></mxCell><mxCell id="c1-mcpa" value="&lt;b&gt;MCP agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External software systems]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Route 1. Call tools on the MCP server: Claude, GitHub Copilot in VS Code, ChatGPT connectors, others.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="300" height="150" as="geometry"/></mxCell><mxCell id="c1-sys" value="&lt;b&gt;DemoGov Permits (HITL prototype)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Fictional permit service with a server-side guard that decides when a human must approve, pauses the agent and verifies the approval before executing.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="400" height="170" as="geometry"/></mxCell><mxCell id="c1-tester" value="&lt;b&gt;Tester / admin&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Runs the test scenarios, reviews requests, signals, decisions and tickets, exports results.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="300" height="150" as="geometry"/></mxCell><mxCell id="c1-auth" value="&lt;b&gt;Passkey authenticator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External device]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;The person&#x27;s phone or platform authenticator. Signs the approval challenge; user verification required.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="300" height="150" as="geometry"/></mxCell><mxCell id="c1-keys" value="&lt;b&gt;Agent key directories&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External systems]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Operators publish public keys at /.well-known/http-message-signatures-directory (Web Bot Auth).&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="760" width="400" height="120" as="geometry"/></mxCell><mxCell id="c1-e1" value="Asks to complete a task&lt;br&gt;[chat or voice]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-human" target="c1-badm"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-e2" value="Asks to complete a task&lt;br&gt;[chat or voice]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-human" target="c1-mcpa"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-e3" value="Signs in, reviews and approves&lt;br&gt;gated steps [HTTPS, WebAuthn]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-human" target="c1-sys"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-e4" value="Operates pages and calls APIs&lt;br&gt;on the person&#x27;s behalf [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-badm" target="c1-sys"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="470"/><mxPoint x="530" y="470"/></Array></mxGeometry></mxCell><mxCell id="c1-e5" value="Calls journey tools&lt;br&gt;[MCP over HTTPS, OAuth 2.1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-mcpa" target="c1-sys"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="470"/><mxPoint x="810" y="470"/></Array></mxGeometry></mxCell><mxCell id="c1-e6" value="Reviews /console&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-tester" target="c1-sys"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-e7" value="Approval assertion&lt;br&gt;[WebAuthn]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-auth" target="c1-sys"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-e8" value="Fetches public keys to verify&lt;br&gt;signed agent requests [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1-sys" target="c1-keys"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-legend-bg" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;strokeColor=#BBBBBB;fillColor=#FFFFFF;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="250" height="132" as="geometry"/></mxCell><mxCell id="c1-legend-0" value="Person" style="whiteSpace=wrap;html=1;fontSize=9;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1122" y="730" width="90" height="26" as="geometry"/></mxCell><mxCell id="c1-legend-t0" value="Person" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="730" width="135" height="26" as="geometry"/></mxCell><mxCell id="c1-legend-1" value="System in scope" style="whiteSpace=wrap;html=1;fontSize=9;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1122" y="764" width="90" height="26" as="geometry"/></mxCell><mxCell id="c1-legend-t1" value="System in scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="764" width="135" height="26" as="geometry"/></mxCell><mxCell id="c1-legend-2" value="External" style="whiteSpace=wrap;html=1;fontSize=9;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1122" y="798" width="90" height="26" as="geometry"/></mxCell><mxCell id="c1-legend-t2" value="External" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="798" width="135" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="C2 Containers" id="hitl-c2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2-title" value="&lt;b&gt;C2: Containers. DemoGov Permits (HITL prototype)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;Single Next.js deployment on Vercel plus Postgres on Supabase. Every mutating route and MCP tool calls the one guard.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="c2-human" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Approver and account holder&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="c2-tester" value="&lt;b&gt;Tester / admin&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Reviews the console&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=18;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="c2-badm" value="&lt;b&gt;Browser agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Route 2&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="c2-mcpa" value="&lt;b&gt;MCP agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Route 1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="c2-auth" value="&lt;b&gt;Passkey authenticator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External device]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Phone or platform&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="240" height="110" as="geometry"/></mxCell><mxCell id="c2-keys" value="&lt;b&gt;Agent key directories&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[External]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Web Bot Auth public keys&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1360" y="680" width="200" height="110" as="geometry"/></mxCell><mxCell id="c2-bsys" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="1030" height="800" as="geometry"/></mxCell><mxCell id="c2-bvercel" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="990" height="560" as="geometry"/></mxCell><mxCell id="c2-bsys-l" value="&lt;b&gt;System boundary: DemoGov Permits&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[Software system]&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="254" width="400" height="30" as="geometry"/></mxCell><mxCell id="c2-bver-l" value="&lt;b&gt;Next.js deployment on Vercel&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[serverless functions, one codebase]&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="294" width="400" height="30" as="geometry"/></mxCell><mxCell id="c2-web" value="&lt;b&gt;Web UI and API server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Container: Next.js App Router, TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Landing, login, journey pages, /approve, /device, /console; journey, HITL, signals and SSE routes; serves signals.js and the WebAuthn client.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="370" height="190" as="geometry"/></mxCell><mxCell id="c2-mcp" value="&lt;b&gt;MCP and OAuth server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Container: MCP TypeScript SDK in a Next.js route]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/mcp Streamable HTTP (revisions 2026-07-28 and 2025-11-25), tool registry, gate modes; OAuth 2.1 authorization server with consent screen.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="370" height="190" as="geometry"/></mxCell><mxCell id="c2-core" value="&lt;b&gt;Enforcement core&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Library: TypeScript, in-process]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;hitlGuard, actor classifier, policy engine, ticket service, canonical hash, WebAuthn, session manager, Web Bot Auth verifier, request log. Policy and classifier config loaded at boot.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="610" y="640" width="420" height="190" as="geometry"/></mxCell><mxCell id="c2-db" value="&lt;b&gt;Postgres database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Container: Supabase Postgres, Drizzle ORM]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;users, passkeys, sessions, session_events, applications, hitl_tickets, request_log, OAuth clients, codes, tokens and keys. RLS on, no anon policies.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="610" y="890" width="420" height="130" as="geometry"/></mxCell><mxCell id="c2-e1" value="Uses journey pages,&lt;br&gt;approves with a passkey&lt;br&gt;[HTTPS, SSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2-human" target="c2-web"><mxGeometry x="-0.55" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2-e2" value="Reviews /console&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2-tester" target="c2-web"><mxGeometry x="-0.55" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2-e3" value="Operates pages,&lt;br&gt;calls APIs [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2-badm" target="c2-web"><mxGeometry x="-0.6" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2-e4" value="Calls tools&lt;br&gt;[MCP, OAuth 2.1 bearer]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2-mcpa" target="c2-mcp"><mxGeometry x="-0.55" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2-e5" value="WebAuthn" style="edgeStyle=orthogonalEdgeStyle;rounded=0