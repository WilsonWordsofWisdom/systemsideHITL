<diagram name="C3 Components: Web API + core" id="hitl-c3a"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3a-title" value="&lt;b&gt;C3: Components. Web UI and API server, and the enforcement core&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;font-weight:normal&#x27;&gt;Adapters (left) call the single guard and the services; the guard decides allow, gate or deny.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#111111;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="c3a-badapt" value="&lt;b&gt;Container: Web UI and API server&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[adapters]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="280" height="870" as="geometry"/></mxCell><mxCell id="c3a-bcore" value="&lt;b&gt;Enforcement core and journey services&lt;/b&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;[in-process library]&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="900" height="870" as="geometry"/></mxCell><mxCell id="c3a-a2" value="&lt;b&gt;Journey API routes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component: route handlers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/api/applications/*, /api/account/contact&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="100" as="geometry"/></mxCell><mxCell id="c3a-a6" value="&lt;b&gt;Console routes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component: route handlers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/console, export, reset (admin)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="230" height="100" as="geometry"/></mxCell><mxCell id="c3a-a3" value="&lt;b&gt;Approval routes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component: route handlers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/approve, /device, /api/hitl/[id]/* incl. SSE events and polling&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="230" height="100" as="geometry"/></mxCell><mxCell id="c3a-a5" value="&lt;b&gt;Auth routes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;[Component: route handlers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;/login, passkey enrolment and sign-in&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="230" height="100" as="geometry"/></mxCell><mxCell id="c3a-a4" value="&lt;b&gt;Signals endpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-