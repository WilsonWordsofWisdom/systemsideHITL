# Copy to .env (never commit .env). Secrets stay empty here; set them locally
# and in Vercel project settings only.

# Origin and passkey RP ID (decision 2026-11-21). For local dev use
# APP_ORIGIN=http://localhost:3000 and RP_ID=localhost.
APP_ORIGIN=https://hitltest.vercel.app
RP_ID=hitltest.vercel.app

# Supabase Postgres: pooled (transaction mode) for the app, direct for migrations and seed.
# If unset, the app falls back to POSTGRES_URL and POSTGRES_URL_NON_POOLING, which Vercel
# adds when Supabase is connected from its Storage tab. Local secrets go in .env.local or .env.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Connections per server instance.
DB_POOL_MAX=5

# End-to-end tests use a local Docker Postgres by default (npm run e2e:db:up).
# With E2E_TARGET=supabase they read a SEPARATE Supabase test database from
# .env.test.local (E2E_DATABASE_URL and E2E_DIRECT_DATABASE_URL). Either way they
# reset it on every run and refuse to run if it is the same database as .env.local.

# Secrets
# At least 32 characters (signs CSRF tokens, salts IP hashes).
SESSION_SECRET=
ADMIN_SECRET=
# At least 12 characters; given to testers out of band, never committed.
DEMO_USER_PASSWORD=

# HITL behaviour
TICKET_TTL_SECONDS=600
HITL_MODE=enforce
# Must be "true" before HITL_MODE=observe is accepted.
HITL_ALLOW_OBSERVE=false

# Experiment flags (PRD section 9.4)
AGENT_HINTS=off
SELF_DECLARE_UI=on
HITL_HANDOFF_MODE=panel
HITL_AUTORESUME=off
HITL_GATE_STATUS=403
PASSKEY_ENROLMENT=closed
MCP_STEP_SCOPED_TOOLS=off
MCP_GATE_MODE=tool_result
# T15 runs only: shows the prompt-injection fixture on the journey and at /notices/t15.
T15_FIXTURE=off
# Phase 7: Personal Agent Protocol (Poppy) discovery and formats. Off for baseline runs.
POPPY=off
